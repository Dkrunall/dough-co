# Copy to .env.local (never commit real values) and fill in from Shopify.
# Leave these empty to run the site with the local placeholder products.

# Your store's myshopify domain, without https://
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API *public* access token (Headless sales channel → Storefront API)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional: Storefront API version (defaults to 2026-07)
# SHOPIFY_API_VERSION=2026-07
